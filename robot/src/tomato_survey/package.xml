<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tomato_survey</name>
  <version>0.1.0</version>
  <description>
    Pha 1 (survey_run): chay lo trinh follow_waypoints, chup anh lien tuc
    khong dung robot, ghi manifest. Pha 2 (batch_infer): sau khi robot ve,
    chay TogroNet-Stage roi co dieu kien TogroNet-Fruit tren tung anh.
  </description>
  <maintainer email="duongduccuong30042002@gmail.com">pi</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
